{
  "name": "bhashasetu",
  "productName": "BhashaSetu",
  "version": "1.0.0",
  "description": "BhashaSetu — Interstate Voice Translator & Offline Mesh",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "start:dev": "tsx server.ts",
    "build:mobile:android": "npm run build && npx cap sync android",
    "build:mobile:ios": "npm run build && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:desktop:mac": "npm run build && electron-builder --mac",
    "build:desktop:win": "npm run build && electron-builder --win",
    "build:all-platforms": "npm run build && npx cap sync && electron-builder --mac --win",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx test/rooms.test.ts && NODE_ENV=test tsx test/dualTalk.test.ts && NODE_ENV=test tsx test/diagnosticsQuota.test.ts && NODE_ENV=test tsx test/audioSettings.test.ts && NODE_ENV=test tsx test/wordLearning.test.ts && NODE_ENV=test tsx test/languageDashboard.test.ts && NODE_ENV=test tsx test/smartReplyService.test.ts && NODE_ENV=test tsx test/meshTopology.test.ts && NODE_ENV=test tsx test/opusCodec.test.ts && NODE_ENV=test tsx test/securityHardening.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/peerjs": "^1.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "peerjs": "^1.5.5",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
